# Copy to .env.local (ignored by git) and fill in. `./scripts/run-local.sh` generates the two keys
# when they are empty. Names only here: no value in this file is ever a real one.
ANKKA_SECRET_KEY=
VOICE_SESSION_KEY=
VOICE_INVITE_CODES=pilot
VOICE_REASONING_URL=http://localhost:9100
ANKKA_AUTH_ISSUERS=staff
ANKKA_AUTH_STAFF_ISSUER=http://localhost:8180/realms/voice-staff
ANKKA_AUTH_STAFF_JWKS_URL=http://localhost:8180/realms/voice-staff/protocol/openid-connect/certs
ANKKA_AUTH_STAFF_AUDIENCE=voice-staff
ANTHROPIC_API_KEY=
VOICE_DORMANCY_PERIOD=180d
VOICE_SUPPRESSION_THRESHOLD=5
VOICE_SESSION_HOURS=12
# Read by `just seed` only, never by the service: a token from the local realm's `seed` user.
SEED_STAFF_TOKEN=
